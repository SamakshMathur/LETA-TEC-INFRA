# LETA TITAN: PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# Copy this to .env in your production environment

# --- LLM PROVIDER ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- DATABASE ---
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=leta_history

# --- SECURITY ---
# Run 'openssl rand -hex 32' to generate a secure secret
SECRET_KEY=your_secret_key_here

# --- EMBEDDINGS ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# --- PRODUCTION SETTINGS ---
PORT=8000
HOST=0.0.0.0
ENV=production
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
