# LETA TEC: PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# Copy this to .env in your production environment

# --- LLM PROVIDER ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- DATABASE ---
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=leta_history

# --- SECURITY ---
# Run 'openssl rand -hex 32' to generate a secure secret
SECRET_KEY=your_secret_key_here
# Run 'openssl rand -hex 32' for a separate admin secret
ADMIN_MASTER_SECRET=your_admin_secret_here

# --- AUTH / OTP ---
# Set to "true" ONLY in local development — returns otp_preview and skips OTP validation.
# Must be "false" (or unset) in production.
DEV_MODE=false

# --- EMBEDDINGS ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# --- CACHE / RATE LIMITING ---
REDIS_URL=redis://localhost:6379/0

# --- CONCURRENCY ---
# Number of Gunicorn workers. Each worker loads ~600 MB of models.
# Recommended: 2 for 4 GB RAM, 4 for 8 GB RAM, 8 for 16 GB RAM.
WORKERS=2

# --- PRODUCTION SETTINGS ---
PORT=8000
HOST=0.0.0.0
ENV=production
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
